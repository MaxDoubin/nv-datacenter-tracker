{
  "name": "nv-datacenter-tracker",
  "version": "1.0.0",
  "description": "An open dataset of Nevada's data center tax abatements: what was promised, what it cost, and what was delivered.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "engines": { "node": ">=23.6" },
  "scripts": {
    "validate": "node src/scripts/validate.ts",
    "validate:strict": "node src/scripts/validate.ts --strict",
    "build": "node src/scripts/build.ts",
    "report": "node src/scripts/report.ts",
    "check-sources": "node src/scripts/check-sources.ts",
    "test": "node --test \"tests/*.test.ts\"",
    "serve": "node src/scripts/serve.ts",
    "ci": "npm run validate:strict && npm test && npm run build"
  },
  "keywords": ["nevada", "data-centers", "tax-abatements", "open-data", "transparency", "civic-tech", "nrs-360-754"],
  "repository": { "type": "git", "url": "https://github.com/MaxDoubin/nv-datacenter-tracker.git" }
}
