{
  // Cloudflare Workers static assets. The site is fully static, so there is no
  // Worker script — Cloudflare serves dist/ directly from its edge.
  // Static asset requests are free and unmetered on the Workers free plan.
  "name": "nv-datacenter-tracker",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    // The app uses hash routing, so real paths are real files and a miss
    // should be an honest 404 (the JSON API depends on that).
    "not_found_handling": "none"
  },
  "observability": { "enabled": true }
}
